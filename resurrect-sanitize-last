#!/bin/sh
#
# tmux-resurrect pre-restore-all hook (also safe to run standalone).
#
# A save interrupted by shutdown can leave `last` pointing at an empty or
# corrupted snapshot, so the restore after reboot brings back nothing.
# Repoint `last` to the newest snapshot that actually contains panes.
#
# Also drops a restore-in-progress guard: the post-boot restore can take
# longer than the continuum save interval, and a save firing mid-restore
# repoints `last` under restore.sh (which re-resolves it for every phase),
# so window names, layouts and processes then load from the half-restored
# snapshot (this degraded the restore on 2026-09-01). While the guard is
# fresh, resurrect-validate-save rejects every save; the post-restore-all
# hook (resurrect-restore-complete) removes it.

dir="${1:-$HOME/.tmux/resurrect}"
last="$dir/last"
log="$dir/validate.log"

touch "$dir/restore-in-progress"

valid() {
  [ -s "$1" ] || return 1
  grep -q '^pane' "$1" || return 1
  [ -z "$(sort "$1" | uniq -d)" ]
}

if [ -e "$last" ] && valid "$last"; then
  exit 0
fi

for f in $(ls -t "$dir"/tmux_resurrect_*.txt 2>/dev/null); do
  if valid "$f"; then
    ln -fs "$(basename "$f")" "$last"
    printf '%s repointed last -> %s\n' \
      "$(date '+%Y-%m-%dT%H:%M:%S')" "$(basename "$f")" >> "$log"
    exit 0
  fi
done

exit 0
